<Window x:Class="Fahrstundenplaner.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nutzerverwaltung" Height="550" Width="700"
        WindowStartupLocation="CenterOwner" Background="#F4F7F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0">
                <TextBlock Text="👥" FontSize="32" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Benutzerverwaltung" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Verwalten Sie hier Fahrlehrer und Administratoren" Foreground="#D1F2EB" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" Margin="20" Padding="20" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="5,0">
                    <TextBlock Text="Benutzername" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtUsername" Height="35" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5,0">
                    <TextBlock Text="Passwort" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtPassword" Height="35" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="5,0">
                    <TextBlock Text="Rolle" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ComboRole" Height="35" SelectedIndex="0">
                        <ComboBoxItem Content="Fahrlehrer"/>
                        <ComboBoxItem Content="Administrator"/>
                    </ComboBox>
                </StackPanel>
                <Button Grid.Column="3" Content="HINZUFÜGEN" Click="AddUser_Click" 
                        Background="#27AE60" Foreground="White" FontWeight="Bold" 
                        Padding="20,0" Margin="5,18,5,0" Height="35">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" Margin="20,0,20,20" CornerRadius="12" Padding="10">
            <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="Transparent" BorderThickness="0" RowHeight="40"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F1F1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Username}" Width="*"/>
                    <DataGridTextColumn Header="ROLLE" Binding="{Binding Role}" Width="150"/>
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Löschen" Click="DeleteUser_Click" 
                                        Background="#E74C3C" Foreground="White" FontSize="11" 
                                        FontWeight="Bold" Padding="10,2" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
