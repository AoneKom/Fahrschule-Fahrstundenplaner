<Window x:Class="Fahrstundenplaner.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="450" Width="400" WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="20" Background="White" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="20,20,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2C3E50" Offset="0"/>
                        <GradientStop Color="#4CA1AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🚗" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Fahrstundenplaner" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Background="Transparent" BorderThickness="0" Foreground="White" Margin="15" Cursor="Hand"/>

            <StackPanel Grid.Row="1" Margin="35,30">
                <TextBlock Text="Benutzername" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <Border BorderBrush="#DCDDE1" BorderThickness="0,0,0,2" Margin="0,0,0,20">
                    <TextBox x:Name="TxtUser" BorderThickness="0" FontSize="15" Padding="5"/>
                </Border>

                <TextBlock Text="Passwort" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <Border BorderBrush="#DCDDE1" BorderThickness="0,0,0,2" Margin="0,0,0,30">
                    <PasswordBox x:Name="TxtPass" BorderThickness="0" FontSize="15" Padding="5"/>
                </Border>

                <Button Content="ANMELDEN" Click="Login_Click" IsDefault="True" Height="45" Background="#2C3E50" Foreground="White">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>